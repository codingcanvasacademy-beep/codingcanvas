# CodingCanvas Environment Variables
# Copy this file to .env.local and fill in the values.

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
# Used for the AI Help Robot and block generator
GOOGLE_AI_API_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon key from your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Hugging Face ─────────────────────────────────────────────────────────────
# API key for Hugging Face Inference API (optional — Gemini is the primary AI)
HUGGINGFACE_API_KEY=

# URL of your deployed Hugging Face Docker Space (the Python sandbox engine)
# Example: https://your-username-codingcanvas-sandbox.hf.space
NEXT_PUBLIC_HF_SPACE_URL=

# ─── Telegram Notifications ───────────────────────────────────────────────────
# 1. Message @BotFather on Telegram, send /newbot, and copy the token it gives you
# 2. Message your new bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value as your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL of your deployed Hugging Face support chatbot Space (optional)
# When set, the website AI assistant uses this instead of Gemini
# Example: https://your-username-codingcanvas-support.hf.space
HF_CHATBOT_URL=

# ─── n8n Automation ───────────────────────────────────────────────────────────
# Webhook URL from your n8n workflow (handles bookings + student telemetry)
N8N_WEBHOOK_URL=
